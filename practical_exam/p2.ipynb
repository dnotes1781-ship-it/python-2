# Import the pandas library.
# 'pandas' is used for reading, analyzing, and manipulating datasets.
# 'pd' is an alias (short name) for pandas.
import pandas as pd

# Read the CSV file and store it in a DataFrame named 'df'.
# read_csv() is a pandas function used to load CSV files.
# "car data.csv" is the dataset file.
# df stands for DataFrame (a table with rows and columns).
df = pd.read_csv("car data.csv")

# Display complete information about the dataset.
# info() shows:
# • Total number of rows and columns
# • Column names
# • Data types (int, float, object, etc.)
# • Non-null values
# • Memory usage
df.info()

# Display the first 5 rows of the dataset.
# head() is useful for checking whether the data has loaded correctly.
df.head()


# =====================================================
# (a) Count Petrol Cars Manufactured After 2015
# =====================================================

# We need two conditions:
# 1. Fuel_Type should be Petrol
# 2. Year should be greater than 2015

# df["Fuel_Type"]
# Selects only the Fuel_Type column.

# ==
# Comparison operator.
# Checks whether the value is equal to "Petrol".

# &
# AND operator used to combine multiple conditions.
# Both conditions must be True.

# df["Year"] > 2015
# Selects only cars manufactured after 2015.

# df[condition]
# Returns only those rows that satisfy the condition.

petrol_cars = df[
    (df["Fuel_Type"] == "Petrol") &
    (df["Year"] > 2015)
]

# len()
# Returns the total number of rows.
# Here it counts how many Petrol cars are manufactured after 2015.
print("Petrol Cars After 2015:", len(petrol_cars))


# =====================================================
# (b) List Cars with More Than 50,000 KM Driven
# =====================================================

# Select all rows where Kms_Driven is greater than 50000.

cars = df[df["Kms_Driven"] > 50000]

# Display only two columns:
# Car_Name
# Kms_Driven

# [["Car_Name","Kms_Driven"]]
# Double square brackets are used to select multiple columns.
print(cars[["Car_Name", "Kms_Driven"]])


# =====================================================
# (c) Average Selling Price by Fuel Type
# =====================================================

# groupby("Fuel_Type")
# Groups all records according to Fuel_Type.
# Example:
# Petrol
# Diesel
# CNG

# ["Selling_Price"]
# Select only the Selling_Price column after grouping.

# mean()
# Calculates the average (mean) selling price for each fuel type.

avg = df.groupby("Fuel_Type")["Selling_Price"].mean()

# Print the average selling price of each fuel type.
print(avg)


# =====================================================
# (d) Detect Outliers Using IQR Method
# =====================================================

# quantile(0.25)
# Finds the 25th percentile.
# This value is called Q1 (First Quartile).
# It means 25% of the data lies below this value.

Q1 = df["Selling_Price"].quantile(0.25)

# quantile(0.75)
# Finds the 75th percentile.
# This value is called Q3 (Third Quartile).
# It means 75% of the data lies below this value.

Q3 = df["Selling_Price"].quantile(0.75)

# IQR stands for Interquartile Range.
# Formula:
# IQR = Q3 - Q1
# It measures the spread of the middle 50% of the data.

IQR = Q3 - Q1

# Lower Limit Formula
# Q1 - 1.5 × IQR
# Any value below this limit is considered an outlier.

lower_limit = Q1 - 1.5 * IQR

# Upper Limit Formula
# Q3 + 1.5 × IQR
# Any value above this limit is considered an outlier.

upper_limit = Q3 + 1.5 * IQR

# Detect Outliers

# <
# Less than operator.

# >
# Greater than operator.

# |
# OR operator.
# If either condition is True,
# the row will be selected.

# df[condition]
# Returns only those rows satisfying the condition.

outliers = df[
    (df["Selling_Price"] < lower_limit) |
    (df["Selling_Price"] > upper_limit)
]

# Print a heading.
print("Outliers in Selling Price:")

# Display only these two columns from the outlier rows.
print(outliers[["Car_Name", "Selling_Price"]])

# len()
# Counts the total number of outlier rows.

print("Number of Outliers:", len(outliers))
