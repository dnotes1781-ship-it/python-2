# Import the pandas library.
# Pandas is used for reading, organizing, and analyzing data.
# 'pd' is a short name (alias) for pandas.
import pandas as pd


# Read the CSV file and store it in a DataFrame named 'df'.
# read_csv() is a pandas function used to load CSV files.
# "StudentsPerformance.csv" is the dataset file.
# df stands for DataFrame (a table with rows and columns).
df = pd.read_csv("StudentsPerformance.csv")


# Display the first 5 rows of the dataset.
# head() helps us quickly check whether the data has been loaded correctly.
df.head()


# =====================================================
# (a) Two-Way Cross Tabulation
# =====================================================

# pd.crosstab()
# Creates a frequency table (cross table).
# It counts how many times each combination occurs.

# df["gender"]
# Selects the 'gender' column from the DataFrame.
# This will become the row labels.

# df["math score"]
# Selects the 'math score' column.
# This will become the column labels.

# The output shows how many students of each gender
# obtained each math score.

cross = pd.crosstab(df["gender"], df["math score"])

# Print the cross-tabulation table.
print(cross)


# =====================================================
# (b) Correlation Matrix
# =====================================================

# corr()
# Calculates the correlation between numeric columns.

# Correlation tells us how strongly two numeric columns
# are related to each other.

# numeric_only=True
# Uses only numeric columns such as:
# • math score
# • reading score
# • writing score
#
# Text columns like gender, race/ethnicity, etc.
# are automatically ignored.

corr = df.corr(numeric_only=True)

# Print the correlation matrix.
print(corr)


# =====================================================
# (c) Statistical Summary
# =====================================================

# describe()
# Generates a statistical summary of all numeric columns.

# It displays:
# • count  -> Total number of values
# • mean   -> Average
# • std    -> Standard Deviation
# • min    -> Smallest value
# • 25%    -> First Quartile (Q1)
# • 50%    -> Median (Middle value)
# • 75%    -> Third Quartile (Q3)
# • max    -> Largest value

summary = df.describe()

# Print the statistical summary.
print(summary)
