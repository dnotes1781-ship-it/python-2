# Import the Pandas library
# 'pd' is a short name (alias) used instead of writing pandas every time.
import pandas as pd

# Import the Seaborn library for creating statistical graphs.
# 'sns' is the standard alias used by almost every Python programmer.
import seaborn as sns

# Import pyplot module from Matplotlib.
# It is mainly used to display graphs using plt.show().
import matplotlib.pyplot as plt


# Read the CSV (Comma Separated Values) file.
# read_csv() is a Pandas function that loads the dataset into a DataFrame.
# DataFrame is a table containing rows and columns.
df = pd.read_csv("sales.csv")


# Store the 'Quantity' column in variable x.
# df["Quantity"] returns the complete Quantity column.
x = df["Quantity"]

# Store the 'Total' column in variable y.
# df["Total"] returns the complete Total column.
y = df["Total"]


# ---------------------- BOXPLOT ----------------------

# Create a boxplot using the Quantity column.
#
# sns        -> Seaborn library
# boxplot()  -> Function used to draw a boxplot
# x=x        -> Use variable x on the X-axis
#
# Purpose:
# - Detect outliers
# - Show minimum value
# - Show maximum value
# - Show median value
# - Show spread of the data
sns.boxplot(x=x)

# Display the graph on the screen.
# Without plt.show(), the graph may not appear.
plt.show()


# ------------------- SCATTER PLOT --------------------

# Create a scatter plot.
#
# sns                -> Seaborn library
# scatterplot()      -> Function to create a scatter plot
# x=x                -> Quantity values on X-axis
# y=y                -> Total values on Y-axis
#
# Purpose:
# Shows the relationship between Quantity and Total.
# Every dot represents one record in the dataset.
sns.scatterplot(x=x, y=y)

# Display the scatter plot.
plt.show()


# -------------------- CORRELATION --------------------

# Calculate correlation between all numeric columns.
#
# corr()             -> Correlation function
# numeric_only=True  -> Ignore text columns and use only numeric columns.
#
# Correlation values are between -1 and +1.
corr = df.corr(numeric_only=True)

# Print the correlation matrix in the output window.
print(corr)


# --------------------- HEATMAP -----------------------

# Draw the correlation matrix as a heatmap.
#
# corr         -> Correlation matrix
# annot=True   -> Display correlation values inside each box.
#
# Darker/Lighter colors indicate stronger or weaker relationships.
sns.heatmap(corr, annot=True)

# Display the heatmap.
plt.show()
