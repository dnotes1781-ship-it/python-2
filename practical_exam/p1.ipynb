import pandas as pd

# Read CSV file
df = pd.read_csv("car data.csv")

# Memory usage
print("Memory Usage:")
print(df.memory_usage())

# Data types
print("\nData Types:")
print(df.dtypes)

# Shape
print("\nShape:")
print(df.shape)

# Summary statistics
print("\nSummary Statistics:")
print(df.describe())

# Missing values
print("\nMissing Values:")
print(df.isnull().sum())

# Remove missing values
df = df.dropna()

# Remove duplicate rows
df = df.drop_duplicates()

# Display cleaned data
print("\nCleaned Data:")
print(df)
