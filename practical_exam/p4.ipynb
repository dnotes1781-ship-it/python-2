# Import the pandas library.
# Pandas is used for reading, organizing, analyzing,
# and manipulating datasets.
# 'pd' is the short name (alias) for pandas.
import pandas as pd


# Read the CSV file and store it in a DataFrame named 'df'.
# read_csv() is a pandas function used to load CSV files.
# "supermarket_sales.csv" is the dataset file.
# df stands for DataFrame (a table with rows and columns).
df = pd.read_csv("supermarket_sales.csv")


# Display the first 5 rows of the dataset.
# head() helps us quickly verify that the data
# has been loaded correctly.
df.head()


# =====================================================
# (a) Calculate Total Revenue by Product Line
# =====================================================

# groupby("Product line")
# Groups all rows based on the values in the
# 'Product line' column.
#
# Example Groups:
# • Health and Beauty
# • Food and Beverages
# • Electronic Accessories
# • Sports and Travel

# ["Total"]
# Select only the Total column after grouping.

# sum()
# Adds all Total values within each Product line.
# This gives the total revenue generated by each product category.

revenue = df.groupby("Product line")["Total"].sum()

# Print the total revenue of each product line.
print(revenue)


# =====================================================
# (b) Calculate Total Revenue by Payment Method
# =====================================================

# groupby("Payment")
# Groups all rows according to the Payment method.
#
# Example Groups:
# • Cash
# • Credit Card
# • Ewallet

# ["Total"]
# Select the Total column.

# sum()
# Adds all sales for each payment method.

payment = df.groupby("Payment")["Total"].sum()

# Print the total revenue generated using
# each payment method.
print(payment)


# =====================================================
# (c) Sorting
# =====================================================

# sort_values()
# Sorts the DataFrame according to a column.

# by="Total"
# Specifies that sorting should be done using
# the Total column.

# ascending=False
# False means Highest → Lowest.
# True means Lowest → Highest.

sorted_data = df.sort_values(by="Total", ascending=False)

# Print the sorted dataset.
print(sorted_data)


# =====================================================
# (d) Filtering
# =====================================================

# df["Total"] > 500
# Select only rows where the Total value
# is greater than 500.

# >
# Greater than comparison operator.

# df[condition]
# Returns only those rows that satisfy the condition.

filtered = df[df["Total"] > 500]

# Print all rows where Total is greater than 500.
print(filtered)
